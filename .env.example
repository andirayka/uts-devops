# Docker Compose MySQL defaults.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=axon_password
DB_NAME=classicmodels
PORT=3000

# Use demo without a database, or mysql to read classicmodels.
DATA_SOURCE=demo

# Required only for a host-run app when DATA_SOURCE=mysql. Docker Compose builds
# its internal DATABASE_URL from DB_* and the mysql service hostname.
# Keep this server-side variable private.
# Example: mysql://axon:<password>@127.0.0.1:3306/classicmodels
DATABASE_URL=
